		</MODELS>
	</HEADERSECTION>
	<DATASECTION>
		<!-- ObjectOperationMode.xtf -->
		<DataTest1.TopicA BID="bid1" KIND="FULL">
			<DataTest1.TopicA.ClassA TID="oid1" OPERATION="INSERT"></DataTest1.TopicA.ClassA>
			<DataTest1.TopicA.ClassA TID="oid2" OPERATION="UPDATE"></DataTest1.TopicA.ClassA>
			<DataTest1.TopicA.ClassA TID="oid3" OPERATION="DELETE"></DataTest1.TopicA.ClassA>
		</DataTest1.TopicA>
		<DataTest1.TopicA BID="bid2" KIND="UPDATE" STARTSTATE="state1" ENDSTATE="state2">
